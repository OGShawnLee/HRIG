HRIG_API_ADDR=:80
HRIG_ALLOWED_ORIGINS=http://127.0.0.1:9245,http://localhost:9245,wails://wails
# PostgreSQL connection string (DATABASE_URL is preferred; HRIG_DATABASE_URL is supported as fallback)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/hrig?sslmode=disable
# HRIG_DATABASE_URL=postgres://postgres@127.0.0.1:5432/hrig?sslmode=disable
